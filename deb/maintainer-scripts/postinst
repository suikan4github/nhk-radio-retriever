#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd nhk-radio >/dev/null; then
        adduser --system --group --home /var/lib/nhk-radio-retriever \
            --gecos "nhk-radio-retriever" nhk-radio
    fi
fi

#DEBHELPER#

# インストール直後にserviceが実行されないよう、timerだけを開始する。
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke start nhk-radio-retriever.timer >/dev/null || true
fi
